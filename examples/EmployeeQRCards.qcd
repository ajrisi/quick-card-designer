
                <svg xmlns="http://www.w3.org/2000/svg" width="900" height="1500" 
                     data-card-settings="{&quot;w&quot;:900,&quot;h&quot;:1500,&quot;land&quot;:false,&quot;unit&quot;:&quot;in&quot;,&quot;dpi&quot;:300,&quot;margin&quot;:{&quot;t&quot;:&quot;0&quot;,&quot;r&quot;:&quot;0&quot;,&quot;b&quot;:&quot;0&quot;,&quot;l&quot;:&quot;0&quot;},&quot;safeMargin&quot;:{&quot;t&quot;:&quot;0&quot;,&quot;r&quot;:&quot;0&quot;,&quot;b&quot;:&quot;0&quot;,&quot;l&quot;:&quot;0&quot;},&quot;guide&quot;:true,&quot;cutLineW&quot;:&quot;1&quot;,&quot;cutLineStyle&quot;:&quot;dashed&quot;,&quot;cutLineColor&quot;:&quot;#d1d5db&quot;,&quot;printCutLine&quot;:true,&quot;bindingLineW&quot;:&quot;1&quot;,&quot;bindingLineStyle&quot;:&quot;dashed&quot;,&quot;bindingLineColor&quot;:&quot;#9ca3af&quot;,&quot;printer&quot;:{&quot;paper&quot;:&quot;letter&quot;,&quot;orient&quot;:&quot;portrait&quot;,&quot;alignX&quot;:&quot;center&quot;,&quot;alignY&quot;:&quot;center&quot;,&quot;duplex&quot;:false,&quot;gridRevCol&quot;:true,&quot;gridRevRow&quot;:false,&quot;mirrorH&quot;:false,&quot;mirrorV&quot;:false,&quot;rotate180&quot;:false,&quot;driftX&quot;:&quot;0&quot;,&quot;driftY&quot;:&quot;0&quot;,&quot;targetDpi&quot;:&quot;300&quot;,&quot;bleed&quot;:&quot;0&quot;,&quot;showBleed&quot;:false,&quot;cropMarks&quot;:true,&quot;internalMarks&quot;:true,&quot;markColor&quot;:&quot;#9ca3af&quot;,&quot;vernier&quot;:false},&quot;hasCustomBack&quot;:false,&quot;frontBg&quot;:&quot;bg-blank&quot;,&quot;backBg&quot;:&quot;bg-blank&quot;,&quot;mergeSources&quot;:{&quot;src_1786022740256&quot;:{&quot;filename&quot;:&quot;employee_id_cards_test_data.csv&quot;,&quot;data&quot;:[[&quot;Employee_ID&quot;,&quot;Employee_Name&quot;,&quot;Security_Level&quot;,&quot;Secret_Fact&quot;],[&quot;EMP-101&quot;,&quot;Arthur Pendelton&quot;,&quot;Level 3 - Confidential&quot;,&quot;Still sleeps with a worn-out baby blanket named &#39;Mr. Fluff&#39;&quot;],[&quot;EMP-102&quot;,&quot;Beatrice Vance&quot;,&quot;Level 5 - Top Secret&quot;,&quot;Practices Oscar acceptance speeches in front of the bathroom mirror using a banana&quot;],[&quot;EMP-103&quot;,&quot;Charles Montgomery&quot;,&quot;Level 2 - Internal&quot;,&quot;Cried openly during the live-action Cats movie&quot;],[&quot;EMP-104&quot;,&quot;Diana Prince&quot;,&quot;Level 4 - Restricted&quot;,&quot;Runs a wildly popular secret fan-fiction blog about medieval plumbing&quot;],[&quot;EMP-105&quot;,&quot;Ethan Huntley&quot;,&quot;Level 1 - Public&quot;,&quot;Once got stuck in a children&#39;s play tube at a fast-food restaurant and had to be rescued by the fire department&quot;],[&quot;EMP-106&quot;,&quot;Fiona Gallagher&quot;,&quot;Level 3 - Confidential&quot;,&quot;Convinced pigeons are government surveillance drones and leaves them tiny apology notes&quot;],[&quot;EMP-107&quot;,&quot;George Harrison&quot;,&quot;Level 5 - Top Secret&quot;,&quot;Talks to his houseplants and gets genuinely depressed when one drops a leaf&quot;],[&quot;EMP-108&quot;,&quot;Hannah Abbott&quot;,&quot;Level 2 - Internal&quot;,&quot;Has never watched a single Star Wars movie despite wearing a full Darth Vader costume to work once&quot;],[&quot;EMP-109&quot;,&quot;Ian Malcolm&quot;,&quot;Level 4 - Restricted&quot;,&quot;Once somehow managed to burn water while trying to make instant ramen&quot;],[&quot;EMP-110&quot;,&quot;Julia Roberts&quot;,&quot;Level 3 - Confidential&quot;,&quot;Blasts cheesy 90s boyband music at maximum volume whenever she drives alone&quot;]],&quot;hasHeader&quot;:true}},&quot;pluginsData&quot;:{&quot;plug_1786022687640&quot;:{&quot;filename&quot;:&quot;QR_Generator.js&quot;,&quot;code&quot;:&quot;// Quick Card Designer Plugin: QR Code Generator\n(function() {\n    if (!window.QRCode) {\n        const script = document.createElement(&#39;script&#39;);\n        script.src = &#39;https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js&#39;;\n        script.onload = () =&gt; {\n            if (typeof updateAllCanvasImages === &#39;function&#39;) updateAllCanvasImages();\n            if (typeof queueWorkspaceGridUpdate === &#39;function&#39;) queueWorkspaceGridUpdate();\n        };\n        document.head.appendChild(script);\n    }\n\n    const qrCache = new Map();\n\n    return {\n        register: function() {\n            return {\n                name: \&quot;QR_Generator\&quot;,\n                varnames: [],\n                images: [\&quot;qr_image\&quot;]\n            };\n        },\n        \n        // Updated to the new smooth syntax\n        text: function(varName, context, ...args) {\n            return \&quot;\&quot;;\n        },\n        \n        // Updated to the new smooth syntax\n        image: function(imgName, context, ...args) {\n            if (imgName !== \&quot;qr_image\&quot;) return \&quot;\&quot;;\n\n            // Re-join the arguments since the host app splits them by commas\n            let rawArgs = args.join(&#39;,&#39;);\n            let resolvedArgs = \&quot;\&quot;;\n            \n            // Default configuration\n            let config = {\n                text: \&quot;https://example.com\&quot;,\n                width: 512,\n                height: 512,\n                colorDark: \&quot;#000000\&quot;,\n                colorLight: \&quot;#ffffff\&quot;,\n                correctLevel: window.QRCode ? QRCode.CorrectLevel.H : 2\n            };\n\n            if (rawArgs.trim()) {\n                // 1. Pass the raw string through the host app&#39;s native template engine!\n                if (typeof window.renderTemplateString === &#39;function&#39;) {\n                    resolvedArgs = window.renderTemplateString(rawArgs, context.rowIndex);\n                } else {\n                    resolvedArgs = rawArgs;\n                }\n\n                // 2. Safely parse the result into an object\n                try {\n                    // Using `new Function` allows relaxed JSON (single quotes, no quotes on keys, etc.)\n                    let userConfig = new Function(\&quot;return \&quot; + resolvedArgs)();\n                    \n                    if (typeof userConfig === &#39;string&#39;) {\n                        config.text = userConfig;\n                    } else if (typeof userConfig === &#39;object&#39;) {\n                        config = Object.assign(config, userConfig);\n                    }\n                } catch(e) {\n                    // If it isn&#39;t an object/string literal, assume they just typed a raw URL/Template\n                    // e.g. {{my_data.csv, link}}\n                    config.text = resolvedArgs;\n                }\n            }\n\n            if (!window.QRCode) {\n                return &#39;&lt;svg xmlns=\&quot;http://www.w3.org/2000/svg\&quot; width=\&quot;100\&quot; height=\&quot;100\&quot;&gt;&lt;rect width=\&quot;100\&quot; height=\&quot;100\&quot; fill=\&quot;#f3f4f6\&quot;/&gt;&lt;text x=\&quot;50%\&quot; y=\&quot;50%\&quot; dominant-baseline=\&quot;middle\&quot; text-anchor=\&quot;middle\&quot; font-size=\&quot;12\&quot; fill=\&quot;#9ca3af\&quot; font-family=\&quot;sans-serif\&quot;&gt;Loading QR...&lt;/text&gt;&lt;/svg&gt;&#39;;\n            }\n\n            // Map string-based correctLevel (\&quot;L\&quot;, \&quot;M\&quot;, \&quot;Q\&quot;, \&quot;H\&quot;) to QRCode constants\n            if (typeof config.correctLevel === &#39;string&#39;) {\n                const levels = { &#39;L&#39;: QRCode.CorrectLevel.L, &#39;M&#39;: QRCode.CorrectLevel.M, &#39;Q&#39;: QRCode.CorrectLevel.Q, &#39;H&#39;: QRCode.CorrectLevel.H };\n                config.correctLevel = levels[config.correctLevel.toUpperCase()] || QRCode.CorrectLevel.H;\n            }\n\n            // Serialize the final configuration to use as our cache key\n            const cacheKey = JSON.stringify(config);\n            if (qrCache.has(cacheKey)) {\n                return qrCache.get(cacheKey);\n            }\n\n            const tempDiv = document.createElement(&#39;div&#39;);\n            try {\n                new QRCode(tempDiv, config);\n                const canvas = tempDiv.querySelector(&#39;canvas&#39;);\n                if (canvas) {\n                    const dataUri = canvas.toDataURL(\&quot;image/png\&quot;);\n                    qrCache.set(cacheKey, dataUri);\n                    return dataUri;\n                }\n            } catch(e) {\n                console.error(\&quot;QR Generation failed\&quot;, e);\n            }\n            \n            return \&quot;\&quot;;\n        }\n    };\n})();&quot;,&quot;name&quot;:&quot;QR_Generator&quot;,&quot;varnames&quot;:[],&quot;images&quot;:[&quot;qr_image&quot;]},&quot;plug_1786026028824&quot;:{&quot;filename&quot;:&quot;color-code-boxes.js&quot;,&quot;code&quot;:&quot;// Quick Card Designer Plugin\n// This script runs in the browser and provides dynamic variables/images.\n(function() {\n    return {\n        // Register the plugin&#39;s name and available template variables/images\n        register: function() {\n            return {\n                name: \&quot;security_cards\&quot;,\n                varnames: [],\n                images: []\n            };\n        },\n\n        render: function(cardElement, context) {\n            // 1. Fetch the raw data from the current row\n            const securityStr = context.getCSVValue(\&quot;employee_id_cards_test_data.csv\&quot;, \&quot;Security_Level\&quot;) || \&quot;\&quot;;\n            const secretFact = context.getCSVValue(\&quot;employee_id_cards_test_data.csv\&quot;, \&quot;Secret_Fact\&quot;) || \&quot;No secrets here.\&quot;;\n            \n            // 2. Extract just the level number (e.g., pulls \&quot;3\&quot; out of \&quot;Level 3 - Confidential\&quot;)\n            const levelMatch = securityStr.match(/Level\\s(\\d)/);\n            const levelNum = levelMatch ? levelMatch[1] : \&quot;?\&quot;;\n\n            // 3. Determine the thematic color based on the threat level\n            let themeColor = &#39;#e5e7eb&#39;; // Default Gray\n            if (levelNum === &#39;5&#39;) themeColor = &#39;#ef4444&#39;; // Red (Top Secret)\n            else if (levelNum === &#39;4&#39;) themeColor = &#39;#f97316&#39;; // Orange (Restricted)\n            else if (levelNum === &#39;3&#39;) themeColor = &#39;#eab308&#39;; // Yellow (Confidential)\n            else if (levelNum === &#39;2&#39;) themeColor = &#39;#3b82f6&#39;; // Blue (Internal)\n            else if (levelNum === &#39;1&#39;) themeColor = &#39;#10b981&#39;; // Green (Public)\n\n            // 4. Paint the Background Box\n            context.$(&#39;id_bg_box&#39;)\n                   .bg(themeColor)\n                   .css(&#39;opacity&#39;, &#39;0.15&#39;); // Make it a soft tinted background\n\n            // 5. Inject the number into the Circle and colorize it\n            context.$(&#39;security_circle&#39;)\n                   //.text(levelNum)\n                   .bg(themeColor)\n                   //.color(&#39;#ffffff&#39;) // White text\n                   .stroke(&#39;#ffffff&#39;, 2); // 2px white border\n           context.$(&#39;security_level&#39;).text(levelNum);\n\n        }\n    };\n})();&quot;,&quot;name&quot;:&quot;security_cards&quot;,&quot;varnames&quot;:[],&quot;images&quot;:[]}},&quot;globalMergeIndex&quot;:0,&quot;bgConfigFront&quot;:{&quot;color&quot;:&quot;#cbd5e1&quot;,&quot;thick&quot;:1,&quot;gridSz&quot;:0.25,&quot;ruleSp&quot;:0.31,&quot;ruleSkip&quot;:1},&quot;bgConfigBack&quot;:{&quot;color&quot;:&quot;#cbd5e1&quot;,&quot;thick&quot;:1,&quot;gridSz&quot;:0.25,&quot;ruleSp&quot;:0.31,&quot;ruleSkip&quot;:1},&quot;imageAssets&quot;:{},&quot;customFonts&quot;:{&quot;DS-DIGIB&quot;:&quot;data:font/ttf;base64,&quot;}}" 
                     data-card-html-front="%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C!--%20Elements%20dynamically%20inject%20here%20--%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdiv%20class%3D%22element-container%20bg-transparent%22%20id%3D%22el_1786022767477_761%22%20data-type%3D%22title%22%20style%3D%22z-index%3A%20101%3B%20left%3A%2099.5px%3B%20top%3A%20118.71px%3B%20min-width%3A%200px%3B%20min-height%3A%200px%3B%20transform%3A%20rotate(0deg)%3B%22%20data-merge-source-id%3D%22src_1786022740256%22%20data-merge-col%3D%221%22%20data-merge-data%3D%22%5B%26quot%3BArthur%20Pendelton%26quot%3B%2C%26quot%3BBeatrice%20Vance%26quot%3B%2C%26quot%3BCharles%20Montgomery%26quot%3B%2C%26quot%3BDiana%20Prince%26quot%3B%2C%26quot%3BEthan%20Huntley%26quot%3B%2C%26quot%3BFiona%20Gallagher%26quot%3B%2C%26quot%3BGeorge%20Harrison%26quot%3B%2C%26quot%3BHannah%20Abbott%26quot%3B%2C%26quot%3BIan%20Malcolm%26quot%3B%2C%26quot%3BJulia%20Roberts%26quot%3B%5D%22%20data-flip-x%3D%22false%22%20data-flip-y%3D%22false%22%20data-init-vis-x%3D%220%22%20data-init-vis-y%3D%220%22%20data-init-vis-w%3D%22746%22%20data-init-vis-h%3D%22302%22%20data-init-left%3D%2277%22%20data-init-top%3D%22118.71%22%20data-start-flip-x%3D%22false%22%20data-start-flip-y%3D%22false%22%3E%0A%20%20%20%20%20%20%20%20%0A%20%20%20%20%20%20%20%20%0A%20%20%20%20%20%20%20%20%0A%20%20%20%20%20%20%20%20%0A%20%20%20%20%20%20%20%20%0A%20%20%20%20%20%20%20%20%0A%20%20%20%20%20%20%20%20%0A%20%20%20%20%20%20%20%20%0A%20%20%20%20%20%20%20%20%0A%20%20%20%20%20%20%20%20%0A%20%20%20%20%20%20%20%20%0A%20%20%20%20%20%20%20%20%0A%20%20%20%20%20%20%20%20%0A%20%20%20%20%20%20%20%20%0A%20%20%20%20%20%20%20%20%0A%20%20%20%20%20%20%20%20%0A%20%20%20%20%20%20%20%20%0A%20%20%20%20%3Cdiv%20contenteditable%3D%22true%22%20placeholder%3D%22Title%20Here%22%20class%3D%22resizable%22%20style%3D%22font-size%3A%20100px%3B%20font-weight%3A%20bold%3B%20width%3A%20701px%3B%20text-align%3A%20center%3B%20display%3A%20flex%3B%