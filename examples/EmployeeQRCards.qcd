                    <foreignObject x="0" y="0" width="100%" height="100%">
                        <div xmlns="http://www.w3.org/1999/xhtml" style="width: 900px; height: 1500px;margin: 0; padding: 0; font-family: Inter, system-ui, sans-serif; font-size: 16px; font-weight: 400; font-style: normal; line-height: 1.5; letter-spacing: normal; color: rgb(31, 41, 55); text-align: start; -webkit-font-smoothing: antialiased; text-rendering: optimizelegibility; ">
                            <style>
                                <![CDATA[
                                html, body { overscroll-behavior: none; }
body { font-family: Inter, system-ui, sans-serif; background-color: rgb(243, 244, 246); margin: 0px; padding: 0px; height: 100vh; display: flex; flex-direction: column; overflow: hidden; -webkit-font-smoothing: antialiased; text-rendering: optimizelegibility; }
* { box-sizing: border-box; }
.canvas-container { flex-grow: 1; display: block; overflow: hidden; position: relative; }
#card-canvas { background-color: white; box-shadow: rgba(0, 0, 0, 0.1) 0px 20px 25px -5px, rgba(0, 0, 0, 0.04) 0px 10px 10px -5px; position: relative; transition: width 0.3s, height 0.3s, box-shadow 0.3s; flex-shrink: 0; --inverse-scale: 1; }
#card-canvas { --bg-color: #cbd5e1; --bg-thick: 1px; --bg-grid-sz: 25px; --bg-rule-sp: 31px; --bg-rule-top: 31px; }
.bg-blank { background-image: none; background-color: white; }
.bg-ruled { background-color: white; background-image: linear-gradient(white var(--bg-rule-top), transparent var(--bg-rule-top)),
                linear-gradient(var(--bg-color) var(--bg-thick), transparent var(--bg-thick)); background-size: 100% 100%, 100% var(--bg-rule-sp); background-position: 0 0, 0 var(--bg-rule-top); }
.bg-grid { background-color: white; background-image: linear-gradient(to right, var(--bg-color) var(--bg-thick), transparent var(--bg-thick)),
                linear-gradient(to bottom, var(--bg-color) var(--bg-thick), transparent var(--bg-thick)); background-size: var(--bg-grid-sz) var(--bg-grid-sz); }
.bg-dotted { background-color: white; background-image: radial-gradient(circle, var(--bg-color) var(--bg-thick), transparent calc(var(--bg-thick) + 0.5px)); background-size: var(--bg-grid-sz) var(--bg-grid-sz); background-position: 0px 0px; }
.element-container { position: absolute; min-width: 10px; min-height: 10px; box-sizing: content-box !important; border-width: medium !important; border-style: none !important; border-color: currentcolor !important; border-image: none !important; outline: none !important; }
.element-container .controls { display: none; position: absolute; background: rgb(255, 255, 255); border: 1px solid rgb(229, 231, 235); border-radius: 6px; padding: 4px; white-space: nowrap; z-index: 1000; box-shadow: rgba(0, 0, 0, 0.1) 0px 4px 6px -1px, rgba(0, 0, 0, 0.06) 0px 2px 4px -1px; align-items: center; transform: scale(var(--inverse-scale)); }
.element-container .controls.popover-nw { top: -34px; left: -2px; transform-origin: left bottom; }
.element-container .controls.popover-ne { top: -34px; right: -2px; left: auto; transform-origin: right bottom; }
.element-container .controls.popover-sw { bottom: -34px; top: auto; left: -2px; transform-origin: left top; }
.element-container .controls.popover-se { inset: auto -2px -34px auto; transform-origin: right top; }
.element-container:hover > .controls, .element-container.active > .controls { display: flex; gap: 4px; }
.control-btn { display: flex; align-items: center; justify-content: center; width: 24px; height: 24px; border-radius: 4px; color: rgb(75, 85, 99); background: transparent; cursor: pointer; transition: 0.2s; }
.control-btn:hover { background: rgb(243, 244, 246); color: rgb(17, 24, 39); }
.drag-handle { cursor: grab; color: rgb(75, 85, 99); }
.drag-handle:hover { color: rgb(17, 24, 39); background: rgb(243, 244, 246); }
.drag-handle:active { cursor: grabbing; }
.delete-btn { color: rgb(239, 68, 68); }
.delete-btn:hover { background: rgb(254, 242, 242); color: rgb(220, 38, 38); }
.rot-handle { display: none; position: absolute; width: 10px; height: 10px; background: white; border: 2px solid rgb(59, 130, 246); border-radius: 50%; z-index: 1001; cursor: crosshair; transform: scale(var(--inverse-scale)); }
.element-container.rotation-active .rot-handle { display: block; }
.rot-handle.nw { top: -6px; left: -6px; }
.rot-handle.ne { top: -6px; right: -6px; }
.rot-handle.sw { bottom: -6px; left: -6px; }
.rot-handle.se { bottom: -6px; right: -6px; }
.element-container:not(.active):not(:hover) .resizable { resize: none !important; }
.resizer { display: none; position: absolute; z-index: 1002; transform: scale(var(--inverse-scale)); }
.element-container.active:not(.rotation-active) > .resizer { display: block; }
.resizer.n { top: -6px; left: 6px; right: 6px; height: 12px; cursor: n-resize; }
.resizer.s { bottom: -6px; left: 6px; right: 6px; height: 12px; cursor: s-resize; }
.resizer.e { right: -6px; top: 6px; bottom: 6px; width: 12px; cursor: e-resize; }
.resizer.w { left: -6px; top: 6px; bottom: 6px; width: 12px; cursor: w-resize; }
.resizer.nw { top: -6px; left: -6px; width: 12px; height: 12px; cursor: nw-resize; }
.resizer.ne { top: -6px; right: -6px; width: 12px; height: 12px; cursor: ne-resize; }
.resizer.sw { bottom: -6px; left: -6px; width: 12px; height: 12px; cursor: sw-resize; }
.resizer.se { bottom: -6px; right: -6px; width: 12px; height: 12px; cursor: se-resize; }
.resizer::after { content: ""; position: absolute; display: none; background: rgb(59, 130, 246); opacity: 0.9; }
.resizer:hover::after { display: block; }
.resizer.nw::after, .resizer.ne::after, .resizer.sw::after, .resizer.se::after { width: 8px; height: 8px; border-radius: 2px; }
.resizer.nw::after { top: 4px; left: 4px; }
.resizer.ne::after { top: 4px; right: 4px; }
.resizer.sw::after { bottom: 4px; left: 4px; }
.resizer.se::after { bottom: 4px; right: 4px; }
.resizer.n::after, .resizer.s::after { width: 16px; height: 4px; border-radius: 2px; left: 50%; transform: translateX(-50%); }
.resizer.n::after { top: 4px; }
.resizer.s::after { bottom: 4px; }
.resizer.e::after, .resizer.w::after { width: 4px; height: 16px; border-radius: 2px; top: 50%; transform: translateY(-50%); }
.resizer.e::after { right: 4px; }
.resizer.w::after { left: 4px; }
.element-container.active > .custom-resizer { display: block; }
[contenteditable="true"] { outline: none; cursor: text; white-space: pre-wrap; }
div[contenteditable="true"] { width: 100%; height: 100%; min-height: 20px; }
[contenteditable="true"]:empty::before { content: attr(placeholder); color: rgb(156, 163, 175); pointer-events: none; display: block; }
.element-container[data-merge-source-id] [contenteditable="true"]:empty::before, .element-container[data-plugin-image-id] [contenteditable="true"]:empty::before { display: none !important; }
.element-container[data-merge-source-id] .image-placeholder, .element-container[data-plugin-image-id] .image-placeholder, .element-container[data-image-bank-key] .image-placeholder { display: none !important; }
td div[contenteditable="true"], th div[contenteditable="true"] { min-height: 0px !important; }
.card-divider { width: 100%; height: 2px; background-color: rgb(55, 65, 81); }
.resizable { overflow: hidden; }
.element-container[data-type="shape"] .resizable { overflow: visible !important; }
.card-table-wrapper { width: 100%; height: 100%; display: flex; box-sizing: border-box; border-radius: var(--tbl-br, 0px); overflow: hidden; background-color: transparent; border: var(--tbl-bw, 1px) var(--tbl-bs, solid) var(--tbl-bc, #9ca3af); position: relative; transform: translateZ(0px); backface-visibility: hidden; }
.card-table { border-collapse: collapse; table-layout: fixed; width: 100% !important; height: 100% !important; margin: 0px !important; border-style: hidden !important; }
.card-table th, .card-table td { box-sizing: border-box; border: var(--tbl-bw, 1px) var(--tbl-bs, solid) var(--tbl-bc, #9ca3af); position: relative; background-clip: padding-box; padding: 0px !important; min-height: 0px !important; }
.cell-content-layer { position: relative; width: 100%; height: 100%; display: flex; flex-direction: column; overflow: hidden; padding: 4px; box-sizing: border-box; }
.cell-text { flex-grow: 1; width: 100%; height: 100%; background: transparent; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; word-break: break-word; outline: none; display: flex; flex-direction: column; box-sizing: border-box; overflow: hidden; min-height: 0px !important; min-width: 0px !important; }
#print-area { display: none; }
@keyframes caret-blink { 
  0%, 100% { opacity: 1; }
  50% { opacity: 0; }
}
.title-caret::after { content: ""; display: inline-block; width: 1.5px; height: 1.1em; background-color: rgb(31, 41, 55); vertical-align: middle; transform: translateY(-2px); margin-left: 4px; opacity: 0; }
.group:hover .title-caret::after { animation: 1.06s step-end 0s infinite normal none running caret-blink; }
.group:focus-within .title-caret::after { opacity: 0 !important; animation: auto ease 0s 1 normal none running none !important; }
.element-container.hide-controls > .controls { display: none !important; }
.element-container[data-lasers="true"] .laser-btn, #multi-select-controls[data-lasers="true"] .laser-btn, .element-container.rotation-active .rot-btn, #multi-select-controls[data-rotating="true"] .rot-btn { background: rgb(219, 234, 254) !important; color: rgb(37, 99, 235) !important; box-shadow: rgba(0, 0, 0, 0.1) 0px 2px 4px inset !important; }
element-container.group-wrapper, .element-container[data-shape="line"], .element-container[data-shape="curve"] { min-width: 0px !important; min-height: 0px !important; }
