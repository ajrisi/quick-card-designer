                     data-card-html-back="%3Cdiv%20class%3D%22element-container%20bg-transparent%22%20data-type%3D%22text%22%20style%3D%22left%3A%2015px%3B%20top%3A%2086.4px%3B%20z-index%3A%20224%3B%20transform%3A%20rotate(0deg)%3B%22%20data-merge-source-id%3D%22src_1785623886516%22%20data-merge-col%3D%221%22%20data-merge-skip-header%3D%22true%22%20data-merge-data%3D%22%5B%26quot%3BAu%26quot%3B%2C%26quot%3BMars%26quot%3B%2C%26quot%3BCarbon%20dioxide%26quot%3B%2C%26quot%3BMitochondria%26quot%3B%2C%26quot%3BDiamond%26quot%3B%2C%26quot%3BGravity%26quot%3B%2C%26quot%3BNucleus%26quot%3B%2C%26quot%3B300%2C000%20kilometers%20per%20second%20(or%20186%2C000%20miles%20per%20second)%26quot%3B%2C%26quot%3BVitamin%20D%26quot%3B%2C%26quot%3BSkin%26quot%3B%2C%26quot%3B206%26quot%3B%2C%26quot%3BNitrogen%26quot%3B%2C%26quot%3BSeismograph%26quot%3B%2C%26quot%3BH2O%26quot%3B%2C%26quot%3BAlbert%20Einstein%26quot%3B%2C%26quot%3BEvaporation%20or%20vaporization%26quot%3B%2C%26quot%3BMammal%26quot%3B%2C%26quot%3B0%20degrees%20Celsius%26quot%3B%2C%26quot%3BLeaf%20(specifically%20chloroplasts%20within%20the%20cells)%26quot%3B%2C%26quot%3B7%20(neutral)%26quot%3B%2C%26quot%3BO%20negative%26quot%3B%2C%26quot%3BThe%20Milky%20Way%26quot%3B%2C%26quot%3BMeteorology%26quot%3B%2C%26quot%3BFe%26quot%3B%2C%26quot%3BThe%20Sun%26quot%3B%2C%26quot%3BOmnivore%26quot%3B%2C%26quot%3BJupiter%26quot%3B%2C%26quot%3B6%26quot%3B%2C%26quot%3BTelescope%26quot%3B%2C%26quot%3BWeathering%26quot%3B%2C%26quot%3BMercury%26quot%3B%2C%26quot%3BAlexander%20Fleming%26quot%3B%2C%26quot%3BDrone%26quot%3B%2C%26quot%3B212%20degrees%20Fahrenheit%26quot%3B%2C%26quot%3BElectron%26quot%3B%2C%26quot%3BVoice%20box%26quot%3B%2C%26quot%3BMagma%26quot%3B%2C%26quot%3BCell%26quot%3B%2C%26quot%3BVitamin%20K%26quot%3B%2C%26quot%3BCarbon%20dioxide%26quot%3B%2C%26quot%3BProxima%20Centauri%26quot%3B%2C%26quot%3BMeiosis%26quot%3B%2C%26quot%3BEndotherm%20or%20warm-blooded%26quot%3B%2C%26quot%3BNa%26quot%3B%2C%26quot%3BTo%20fight%20infections%20an